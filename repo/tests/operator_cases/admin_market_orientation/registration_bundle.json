      "orientation_id": "orientation-admin-20260806-001",
      "research_commit": "506aa2b9916c614a584459429ebaf1d6fafc9555",
      "objective": "Produce a bounded theoretical article and research project on market orientation and digital marketing capability without fabricating empirical results.",
      "diagnosis": "The topic is broad and risks confusing Kotler's normative framework with empirical causal evidence. The deliverables require a testable construct model and explicit evidence boundaries.",
      "directive": "Use Kotler as an integrative management foundation, operationalize market orientation through empirical literature, treat digital marketing as an organizational capability, and keep all causal claims provisional.",
      "rationale": "This design supports an eight-page theoretical-propositional article and a four-page empirical project while preserving valid extensions for a master's dissertation and a doctoral pre-agenda.",
      "foundations": [
        "Kotler supports value creation, segmentation, targeting, positioning, and strategic market planning.",
        "Market-orientation literature operationalizes intelligence generation, dissemination, responsiveness, customer orientation, competitor orientation, and interfunctional coordination.",
        "Recent SME studies suggest that marketing and digital capabilities may mediate or condition performance relationships, but results vary by context."
      ],
      "required_learning": [
        "Distinguish normative marketing frameworks from causal empirical evidence.",
        "Distinguish digital tool adoption from organizational digital marketing capability.",
        "Distinguish market performance from financial performance."
      ],
      "verification": [
        "The article must state that it presents no empirical results.",
        "The project must describe hypotheses as provisional.",
        "The master's reflection must identify measurement and causal-inference limitations.",
        "The doctoral pre-agenda must explicitly state that it is not a thesis."
      ],
      "recommendations": [
        "Use a theoretical-propositional article as the immediate product.",
        "Design a cross-sectional SME survey only as a future empirical stage.",
        "Include classic and recent literature and record counterevidence or contingencies."
      ],

{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://raw.githubusercontent.com/prefix325/psqza-research/main/schemas/literature-evidence.schema.json","type":"object","additionalProperties":false,"required":["evidence_id","paper_ref","claim_id","evidence_kind","locator_status","locator","summary","verification_status","accepted_for_claim","reviewer","created_at"],"properties":{"evidence_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]*$"},"paper_ref":{"type":"string","minLength":1},"claim_id":{"type":["string","null"]},"evidence_kind":{"enum":["DIRECT","INDIRECT","COUNTEREVIDENCE","INSUFFICIENT","CONTEXTUAL"]},"locator_status":{"enum":["FULL_TEXT_LOCATOR","ABSTRACT_ONLY","METADATA_ONLY","UNAVAILABLE"]},"locator":{"type":["string","null"]},"summary":{"type":"string","minLength":1},"verification_status":{"enum":["PROVISIONAL","VERIFIED","REJECTED"]},"accepted_for_claim":{"type":"boolean"},"reviewer":{"enum":["PSQZA","MECAI","BANCA","HUMAN"]},"created_at":{"type":"string","format":"date-time"}},"allOf":[{"if":{"properties":{"accepted_for_claim":{"const":true}},"required":["accepted_for_claim"]},"then":{"properties":{"locator_status":{"const":"FULL_TEXT_LOCATOR"},"verification_status":{"const":"VERIFIED"},"claim_id":{"type":"string","minLength":1},"locator":{"type":"string","minLength":1}}}}]}

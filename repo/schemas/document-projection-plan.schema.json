{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VERAS Document Projection Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_id", "delta_id", "opinion_id", "base_research_commit", "documents", "cross_document_invariants", "status"],
  "properties": {
    "plan_id": {"type": "string", "minLength": 1},
    "delta_id": {"type": "string", "minLength": 1},
    "opinion_id": {"type": "string", "minLength": 1},
    "base_research_commit": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "documents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document", "action", "sections", "entity_ids"],
        "properties": {
          "document": {"enum": ["PREPROJECT", "ARTICLE", "DISSERTATION", "DOCTORAL_AGENDA"]},
          "action": {"enum": ["UPDATE", "NO_CHANGE", "SUPERSEDE"]},
          "sections": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "entity_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "exclusion_reason": {"type": ["string", "null"]}
        }
      }
    },
    "cross_document_invariants": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["QUESTION_CONSISTENT", "HYPOTHESIS_CONSISTENT", "METHOD_CONSISTENT", "EVIDENCE_STATUS_CONSISTENT", "LIMITATIONS_PROPAGATED", "DOCTORAL_AGENDA_NOT_THESIS", "NO_UNSUPPORTED_CLAIMS", "NO_FROZEN_PLACEHOLDERS"]}},
    "status": {"enum": ["PLANNED", "RENDERED", "VALIDATED", "BLOCKED", "SUPERSEDED"]}
  }
}

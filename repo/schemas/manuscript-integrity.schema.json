{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VERAS Manuscript Integrity Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "topic",
    "documents",
    "sources",
    "source_evidence",
    "source_conflicts",
    "similarity_findings",
    "ai_use_disclosure",
    "human_decision",
    "external_similarity_mode",
    "target_score",
    "score_rubric"
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 3},
    "topic": {"type": "string", "minLength": 10},
    "documents": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string"}},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id","title","authors","year","venue","doi","canonical_url","retrieved_at","access_scope","identity_verified","full_text_verified","license","version","status","metadata_hash","content_hash","fingerprints"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
          "title": {"type": "string", "minLength": 3},
          "authors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
          "year": {"type": "integer", "minimum": 1900, "maximum": 2100},
          "venue": {"type": "string", "minLength": 2},
          "doi": {"type": "string", "pattern": "^10\\.[0-9]{4,9}/\\S+$"},
          "canonical_url": {"type": "string", "format": "uri"},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "access_scope": {"enum": ["FULL_TEXT","ABSTRACT_ONLY"]},
          "identity_verified": {"const": true},
          "full_text_verified": {"type": "boolean"},
          "license": {"type": "string", "minLength": 1},
          "version": {"enum": ["VERSION_OF_RECORD","AUTHOR_MANUSCRIPT","PREPRINT"]},
          "status": {"enum": ["DISCOVERED","FETCHED","IDENTITY_VERIFIED","FULL_TEXT_VERIFIED","EVIDENCE_EXTRACTED","CLAIM_BOUND","CITABLE","CITABLE_LIMITED","BLOCKED"]},
          "metadata_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "fingerprints": {"type": "array", "items": {"type": "string", "minLength": 8}}
        },
        "allOf": [{"if": {"properties": {"status": {"const": "CITABLE"}}}, "then": {"properties": {"access_scope": {"const": "FULL_TEXT"}, "full_text_verified": {"const": true}}}}]
      }
    },
    "source_evidence": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["locator","summary","support_type"],
        "additionalProperties": false,
        "properties": {
          "locator": {"type": "string", "minLength": 3},
          "summary": {"type": "string", "minLength": 20},
          "support_type": {"type": "string", "minLength": 3}
        }
      }
    },
    "source_conflicts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conflict_id","claim_scope","supporting_source_ids","contradicting_source_ids","context_difference","resolution","status"],
        "properties": {
          "conflict_id": {"type": "string", "pattern": "^CONFLICT-[A-Z0-9-]+$"},
          "claim_scope": {"type": "string", "minLength": 10},
          "supporting_source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "contradicting_source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "context_difference": {"type": "string", "minLength": 20},
          "resolution": {"type": "string", "minLength": 20},
          "status": {"const": "RECORDED"}
        }
      }
    },
    "similarity_findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id","iteration","method","query_or_fingerprint","matched_source_id","risk","finding","remediation","status","reviewed_at"],
        "properties": {
          "finding_id": {"type": "string", "pattern": "^SIM-[A-Z0-9-]+$"},
          "iteration": {"type": "integer", "minimum": 1},
          "method": {"enum": ["EXACT_NGRAM","WEB_EXACT_PHRASE","LOCAL_SOURCE_FINGERPRINT","COMMERCIAL_ENGINE"]},
          "query_or_fingerprint": {"type": "string", "minLength": 4},
          "matched_source_id": {"type": ["string","null"]},
          "risk": {"enum": ["NONE","LOW","PARAPHRASE_RISK","DIRECT_COPY_RISK"]},
          "finding": {"type": "string", "minLength": 10},
          "remediation": {"type": "string", "minLength": 3},
          "status": {"enum": ["REMEDIATED","FALSE_POSITIVE_REVIEWED","NO_MATCH","BLOCKED"]},
          "reviewed_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "ai_use_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disclosure_id","tools","purposes","human_responsibilities","source_verification","text_review","private_reasoning_included","status"],
      "properties": {
        "disclosure_id": {"type": "string"},
        "tools": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "purposes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "human_responsibilities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "source_verification": {"const": true},
        "text_review": {"const": true},
        "private_reasoning_included": {"const": false},
        "status": {"const": "DISCLOSED"}
      }
    },
    "human_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id","decision","approved_actions","rejected_actions","recorded_at","presented_by"],
      "properties": {
        "decision_id": {"type": "string"},
        "decision": {"enum": ["APPROVED","PARTIALLY_APPROVED"]},
        "approved_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "rejected_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "recorded_at": {"type": "string", "format": "date-time"},
        "presented_by": {"const": "PSQZA"}
      }
    },
    "external_similarity_mode": {"enum": ["WEB_EXACT_PHRASE_ONLY","COMMERCIAL_ENGINE"]},
    "target_score": {"const": 990},
    "score_rubric": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
  }
}

# Nested repositories and local Git metadata
**/.git/
**/.git/**

# Secrets, credentials and machine-local configuration
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
credentials.json
secrets.json
*token*.txt
*secret*.txt

# Model weights and inference binaries
*.gguf
*.ggml
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
*.bin
models/**
!models/README.md
!models/*LICENSE*
!models/*SHA256*
!models/*checksum*
!models/*manifest*

# Raw datasets and archives; keep only public metadata
data/**
!data/
!data/**/
!data/README.md
!data/**/README*
!data/**/*manifest*
!data/**/*metadata*
!data/**/*provenance*
!data/**/*SHA256SUMS*
!data/**/*checksum*
!data/**/*LICENSE*
*.RData
*.rdata
*.rds
*.parquet
*.feather
*.arrow
*.csv
*.csv.gz
*.tsv
*.tsv.gz

# Container images, exports, archives and volumes
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar
*.oci
*.img
*.vhd
*.vhdx
docker-data/
docker-volumes/

# High-volume scientific per-window outputs and raw process logs
results/**/dpca_metrics.jsonl
results/**/llm_decisions.jsonl
results/**/failed_llm_responses.jsonl
results/**/llama-server.log
results/**/*.stdout.log
results/**/*.stderr.log
results/**/*.png
results/**/*.jpg
results/**/*.jpeg
results/**/*.webp
!results/technical_acceptance/**/*.log
!results/technical_observability/**/*.log

# Pilot/smoke bulk outputs are not part of the frozen final audit mirror
results/pilot/**
results/smoke/**

